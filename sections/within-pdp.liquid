#shopify-section-{{ section.id }} .wp-seal{width:160px;height:160px}
#shopify-section-{{ section.id }} .wp-seal b{font-size:2.6rem}
#shopify-section-{{ section.id }} .wp-seal text{font-size:12px}
#shopify-section-{{ section.id }} .wp-sticky-in{border-radius:18px}
#shopify-section-{{ section.id }} .wp-sticky .wa-btn{padding:0 16px}
}
{% endstyle %}

<div class="wa-root wp">
{%- for block in section.blocks -%}
{%- case block.type -%}

{%- when 'trust' -%}
<div class="wp-trust" {{ block.shopify_attributes }}>
  <div class="wp-trust-in">
  {%- for i in (1..4) -%}{%- assign k = 'item_' | append: i -%}{%- assign t = block.settings[k] -%}
    {%- if t != blank -%}<div class="wp-trust-i"><span class="wp-ico wp-ico-{{ i }}" aria-hidden="true"></span><span>{{ t }}</span></div>{%- endif -%}
  {%- endfor -%}
  </div>
</div>

{%- when 'ugc' -%}
<section class="wa-ugc{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  {%- if block.settings.heading != blank or block.settings.eyebrow != blank -%}<div class="wa-ugc-head wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="wa-h2">{{ block.settings.heading }}</h2>{% endif %}</div>{%- endif -%}
  <div class="wa-ugc-track" data-autoscroll="{{ block.settings.autoscroll_ms }}">
  {%- for i in (1..8) -%}
    {%- assign vk = 'video_' | append: i -%}{%- assign uk = 'video_url_' | append: i -%}{%- assign ck = 'caption_' | append: i -%}
    {%- assign v = block.settings[vk] -%}{%- assign vu = block.settings[uk] -%}{%- assign cap = block.settings[ck] -%}
    {%- capture capt -%}{%- if cap != blank -%}<figcaption class="wa-ugc-cap"><b>{{ cap }}</b>{% if block.settings.verified_label != blank %}<span class="wa-ugc-ver"><i></i>{{ block.settings.verified_label }}</span>{% endif %}</figcaption>{%- endif -%}{%- endcapture -%}
    {%- if v != blank -%}<figure class="wa-ugc-item"><div class="wa-ugc-slide">{{ v | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}{{ capt }}</div></figure>
    {%- elsif vu != blank -%}<figure class="wa-ugc-item"><div class="wa-ugc-slide"><video src="{{ vu }}" autoplay muted loop playsinline preload="metadata"></video>{{ capt }}</div></figure>{%- endif -%}
  {%- endfor -%}
  </div>
</section>

{%- when 'lead' -%}
<section class="wa-sect wp-lead{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-wide wp-lead-g">
    <div class="wp-lead-media wa-reveal">{% if block.settings.image != blank %}<img class="" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">{% elsif block.settings.image_url != blank %}<img class="" src="{{ block.settings.image_url }}" alt="" loading="lazy">{% endif %}</div>
    <div class="wp-lead-copy wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="wp-h">{{ block.settings.heading }}</h2>
      <div class="wp-prose">{{ block.settings.text }}</div>
      {% if block.settings.kicker != blank %}<p class="wp-kicker">{{ block.settings.kicker }}</p>{% endif %}
    </div>
  </div>
</section>

{%- when 'mechanism' -%}
<section class="wa-sect wp-mech wa-dark" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-wide">
    <div class="wa-center wa-reveal wp-mech-head">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2>{% if block.settings.sub != blank %}<p class="wa-sub">{{ block.settings.sub }}</p>{% endif %}</div>
    <div class="wp-vs">
      <div class="wp-vs-c wp-vs-bad wa-reveal">
        <p class="wp-vs-l">{{ block.settings.a_label }}</p>
        <div class="wp-mol wp-mol-big" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="wp-vs-n">{{ block.settings.a_big }}</p>
        {%- assign a_all = block.settings.a_points | newline_to_br | split: '<br />' -%}<ul>{%- for l in a_all -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
      <div class="wp-vs-c wp-vs-good wa-reveal" style="--d:.12s">
        <p class="wp-vs-l">{{ block.settings.b_label }}</p>
        <div class="wp-mol wp-mol-small" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <p class="wp-vs-n">{{ block.settings.b_big }}</p>
        {%- assign b_all = block.settings.b_points | newline_to_br | split: '<br />' -%}<ul>{%- for l in b_all -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
    </div>
    {% if block.settings.note != blank %}<div class="wp-mech-note wa-reveal"><span class="wp-key" aria-hidden="true">2</span><p>{{ block.settings.note }}</p></div>{% endif %}
  </div>
</section>

{%- when 'benefits' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-wide wp-ben">
    <div class="wp-ben-media">{% if block.settings.image != blank %}<img class="" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">{% elsif block.settings.image_url != blank %}<img class="" src="{{ block.settings.image_url }}" alt="" loading="lazy">{% endif %}</div>
    <div class="wp-ben-copy">
      <div class="wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2></div>
      <ul class="wp-ben-list">
      {%- for i in (1..6) -%}{%- assign tk = 'b' | append: i | append: '_title' -%}{%- assign xk = 'b' | append: i | append: '_text' -%}
        {%- if block.settings[tk] != blank -%}<li class="wa-reveal"><b>{{ block.settings[tk] }}</b> {{ block.settings[xk] }}</li>{%- endif -%}
      {%- endfor -%}
      </ul>
      {% if block.settings.cta_label != blank %}<div class="wp-cta">{%- if section.settings.cta_action == "cart" and product != blank -%}<form method="post" action="{{ routes.cart_add_url }}" class="wp-atc"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="wa-btn">{{ block.settings.cta_label }}</button></form>{%- else -%}<a class="wa-btn wa-top" href="#">{{ block.settings.cta_label }}</a>{%- endif -%}{% if block.settings.cta_note != blank %}<p class="wp-cta-note">{{ block.settings.cta_note }}</p>{% endif %}</div>{% endif %}
    </div>
  </div>
</section>

{%- when 'formula' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-wide">
    <div class="wp-head wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2>{% if block.settings.sub != blank %}<p class="wa-sub wa-left">{{ block.settings.sub }}</p>{% endif %}</div>
    <div class="wp-form">
    {%- for i in (1..6) -%}{%- assign nk = 'i' | append: i | append: '_name' -%}
      {%- if block.settings[nk] != blank -%}{%- assign dk = 'i' | append: i | append: '_dose' -%}{%- assign tk = 'i' | append: i | append: '_tag' -%}{%- assign xk = 'i' | append: i | append: '_text' -%}
      <div class="wp-ing wa-reveal" style="--d:{{ forloop.index0 | times: 0.05 }}s"><span class="wp-ing-tag">{{ block.settings[tk] }}</span><p class="wp-ing-dose">{{ block.settings[dk] }}</p><h3>{{ block.settings[nk] }}</h3><p>{{ block.settings[xk] }}</p></div>
      {%- endif -%}
    {%- endfor -%}
    </div>
    {% if block.settings.footnote != blank %}<p class="wp-foot wa-reveal">{{ block.settings.footnote }}</p>{% endif %}
  </div>
</section>

{%- when 'timeline' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-inner">
    <div class="wa-center wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2></div>
    <ol class="wp-tl">
    {%- for i in (1..3) -%}{%- assign wk = 's' | append: i | append: '_when' -%}{%- assign tk = 's' | append: i | append: '_title' -%}{%- assign xk = 's' | append: i | append: '_text' -%}
      {%- if block.settings[tk] != blank -%}<li class="wa-reveal" style="--d:{{ forloop.index0 | times: 0.12 }}s"><span class="wp-tl-w">{{ block.settings[wk] }}</span><h3>{{ block.settings[tk] }}</h3><p>{{ block.settings[xk] }}</p></li>{%- endif -%}
    {%- endfor -%}
    </ol>
    {% if block.settings.note != blank %}<p class="wp-tl-note wa-reveal">{{ block.settings.note }}</p>{% endif %}
  </div>
</section>

{%- when 'reviews' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-wide">
    <div class="wa-center wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2 wp-quote-h">{{ block.settings.heading }}</h2>
      {% if block.settings.rating != blank %}<p class="wp-rating"><span class="wa-stars">★★★★★</span> {{ block.settings.rating }}</p>{% endif %}
    </div>
    {%- if block.settings.stat1 != blank -%}
    <div class="wp-stats wa-reveal">{%- for i in (1..3) -%}{%- assign sk = 'stat' | append: i -%}{%- assign lk = 'stat' | append: i | append: '_label' -%}{%- if block.settings[sk] != blank -%}<div><b>{{ block.settings[sk] }}</b><span>{{ block.settings[lk] }}</span></div>{%- endif -%}{%- endfor -%}</div>
    {% if block.settings.stats_note != blank %}<p class="wa-src wa-reveal">{{ block.settings.stats_note }}</p>{% endif %}
    {%- endif -%}
    <div class="wp-revs">
    {%- for i in (1..3) -%}{%- assign qk = 'r' | append: i | append: '_quote' -%}
      {%- if block.settings[qk] != blank -%}{%- assign hk = 'r' | append: i | append: '_title' -%}{%- assign nk = 'r' | append: i | append: '_name' -%}{%- assign pk = 'r' | append: i | append: '_image' -%}{%- assign uk = 'r' | append: i | append: '_image_url' -%}{%- assign p = block.settings[pk] -%}{%- assign u = block.settings[uk] -%}
      <figure class="wp-rev wa-reveal" style="--d:{{ forloop.index0 | times: 0.1 }}s">
        <div class="wa-stars">★★★★★</div>
        {% if block.settings[hk] != blank %}<h3>{{ block.settings[hk] }}</h3>{% endif %}
        <blockquote>{{ block.settings[qk] }}</blockquote>
        <figcaption>{% if p != blank %}<img class="" src="{{ p | image_url: width: 200 }}" alt="{{ p.alt | escape }}" loading="lazy">{% elsif u != blank %}<img class="" src="{{ u }}" alt="" loading="lazy">{% endif %}<span><b>{{ block.settings[nk] }}</b><em class="wa-ugc-ver" style="color:#2e7d5b"><i></i>{{ block.settings.verified_label }}</em></span></figcaption>
      </figure>
      {%- endif -%}
    {%- endfor -%}
    </div>
  </div>
</section>

{%- when 'compare' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-inner">
    <div class="wa-center wa-reveal" style="margin-bottom:40px">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2></div>
    <div class="wh-cmp wa-reveal" role="table">
      <div class="wh-cmp-r wh-cmp-h" role="row"><span role="columnheader"></span><span class="wh-cmp-w" role="columnheader">{{ block.settings.col_a }}</span><span role="columnheader">{{ block.settings.col_b }}</span><span role="columnheader">{{ block.settings.col_c }}</span></div>
      {%- for i in (1..7) -%}{%- assign lk = 'r' | append: i | append: '_label' -%}
        {%- if block.settings[lk] != blank -%}{%- assign ak = 'r' | append: i | append: '_a' -%}{%- assign bk = 'r' | append: i | append: '_b' -%}{%- assign ck = 'r' | append: i | append: '_c' -%}
        <div class="wh-cmp-r" role="row"><span class="wh-cmp-l" role="rowheader">{{ block.settings[lk] }}</span><span class="wh-cmp-w" role="cell">{{ block.settings[ak] }}</span><span role="cell">{{ block.settings[bk] }}</span><span role="cell">{{ block.settings[ck] }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% if block.settings.cta_label != blank %}<div class="wp-cta">{%- if section.settings.cta_action == "cart" and product != blank -%}<form method="post" action="{{ routes.cart_add_url }}" class="wp-atc"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="wa-btn">{{ block.settings.cta_label }}</button></form>{%- else -%}<a class="wa-btn wa-top" href="#">{{ block.settings.cta_label }}</a>{%- endif -%}{% if block.settings.cta_note != blank %}<p class="wp-cta-note">{{ block.settings.cta_note }}</p>{% endif %}</div>{% endif %}
  </div>
</section>

{%- when 'guarantee' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-inner">
    <div class="wp-gar wa-reveal">
      <div class="wp-seal" aria-hidden="true"><svg viewBox="0 0 200 200"><defs><path id="wpsc" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs><text><textPath href="#wpsc" startOffset="0">{{ block.settings.seal_text }}</textPath></text></svg><b>{{ block.settings.seal_big }}</b><span>{{ block.settings.seal_small }}</span></div>
      <div class="wp-gar-c">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2><div class="wp-prose">{{ block.settings.text }}</div>{% if block.settings.cta_label != blank %}<div class="wp-cta">{%- if section.settings.cta_action == "cart" and product != blank -%}<form method="post" action="{{ routes.cart_add_url }}" class="wp-atc"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="wa-btn">{{ block.settings.cta_label }}</button></form>{%- else -%}<a class="wa-btn wa-top" href="#">{{ block.settings.cta_label }}</a>{%- endif -%}{% if block.settings.cta_note != blank %}<p class="wp-cta-note">{{ block.settings.cta_note }}</p>{% endif %}</div>{% endif %}</div>
    </div>
  </div>
</section>

{%- when 'faq' -%}
<section class="wa-sect{% if block.settings.tinted %} wa-tint{% endif %}" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wa-inner">
    <div class="wa-center wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wa-h2">{{ block.settings.heading }}</h2></div>
    <div class="wa-faq wa-reveal">
    {%- for i in (1..8) -%}{%- assign qk = 'q' | append: i -%}{%- assign q = block.settings[qk] -%}
      {%- if q != blank -%}{%- assign ak = 'a' | append: i -%}<details{% if forloop.first %} open{% endif %}><summary>{{ q }}<span class="wa-pm"></span></summary><div class="wa-ans">{{ block.settings[ak] }}</div></details>{%- endif -%}
    {%- endfor -%}
    </div>
    {% if block.settings.disclaimer != blank %}<div class="wa-disc">{{ block.settings.disclaimer }}</div>{% endif %}
  </div>
</section>

{%- when 'final' -%}
<section class="wp-final" {{ block.shopify_attributes }} style="--pt:{{ block.settings.padding_top }}px;--pb:{{ block.settings.padding_bottom }}px;">
  <div class="wp-final-media">{% if block.settings.image != blank %}<img class="wh-cover" src="{{ block.settings.image | image_url: width: 2200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">{% elsif block.settings.image_url != blank %}<img class="wh-cover" src="{{ block.settings.image_url }}" alt="" loading="lazy">{% endif %}</div>
  <div class="wp-final-in wa-reveal">{% if block.settings.eyebrow != blank %}<p class="wa-eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="wp-final-h">{{ block.settings.heading }}</h2>{% if block.settings.text != blank %}<p class="wa-sub">{{ block.settings.text }}</p>{% endif %}{% if block.settings.cta_label != blank %}<div class="wp-cta">{%- if section.settings.cta_action == "cart" and product != blank -%}<form method="post" action="{{ routes.cart_add_url }}" class="wp-atc"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="wa-btn">{{ block.settings.cta_label }}</button></form>{%- else -%}<a class="wa-btn wa-top" href="#">{{ block.settings.cta_label }}</a>{%- endif -%}{% if block.settings.cta_note != blank %}<p class="wp-cta-note">{{ block.settings.cta_note }}</p>{% endif %}</div>{% endif %}</div>
</section>

{%- endcase -%}
{%- endfor -%}

{%- if section.settings.sticky and product != blank -%}
<div class="wp-sticky" data-sticky>
  <div class="wp-sticky-in">
    {%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="46" height="46">{%- endif -%}
    <div class="wp-sticky-t"><b>{{ product.title }}</b><span>{% if product.price > 0 %}{{ product.price | money }} · {% endif %}{{ section.settings.sticky_note }}</span></div>
    {%- if section.settings.cta_action == "cart" and product != blank -%}<form method="post" action="{{ routes.cart_add_url }}" class="wp-atc"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="wa-btn wp-sticky-b">{{ section.settings.sticky_label }}</button></form>{%- else -%}<a class="wa-btn wp-sticky-b wa-top" href="#">{{ section.settings.sticky_label }}</a>{%- endif -%}
  </div>
</div>
{%- endif -%}
</div>

<script>
(function(){
var S=document.getElementById('shopify-section-{{ section.id }}'); if(!S)return; var R=S.querySelector('.wa-root'); if(!R)return;
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches;
if(!reduce&&'IntersectionObserver' in window){
R.classList.add('wa-js');
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('wa-in');io.unobserve(e.target);}});},{threshold:.12});
R.querySelectorAll('.wa-reveal').forEach(function(e){io.observe(e);});
var px=[].slice.call(R.querySelectorAll('[data-parallax]')),tk=false;
function par(){px.forEach(function(el){var b=el.parentElement.getBoundingClientRect(),vh=innerHeight;if(b.bottom<-100||b.top>vh+100)return;var p=(b.top+b.height/2-vh/2)/vh,a=parseFloat(el.getAttribute('data-parallax'))||.15,c=el.classList.contains('wa-cine-img');el.style.transform='translateY('+(p*a*b.height*-1).toFixed(1)+'px)'+(c?' scale(1.12)':'');});tk=false;}
addEventListener('scroll',function(){if(!tk){requestAnimationFrame(par);tk=true;}},{passive:true});addEventListener('resize',par);par();
var cl=R.querySelector('.wa-cl'),tr=cl?cl.querySelector('.wa-cl-media'):null,gr=tr?tr.parentElement:null,mq=matchMedia('(max-width:860px)'),ct=false;
function mode(){if(!cl)return;if(mq.matches&&cl.getAttribute('data-horizontal')!=='false')cl.classList.add('wa-horiz');else{cl.classList.remove('wa-horiz');if(tr)tr.style.transform='';}}
function upd(){ct=false;if(!cl||!tr||!cl.classList.contains('wa-horiz'))return;var tot=cl.offsetHeight-innerHeight,top=cl.getBoundingClientRect().top,pas=Math.min(Math.max(-top,0),tot),pr=tot>0?pas/tot:0,mx=tr.scrollWidth-gr.clientWidth;if(mx<0)mx=0;tr.style.transform='translateX('+(-pr*mx).toFixed(1)+'px)';}
mode();upd();addEventListener('scroll',function(){if(!ct){requestAnimationFrame(upd);ct=true;}},{passive:true});addEventListener('resize',function(){mode();upd();});
function cu(el){var t=parseInt(el.getAttribute('data-count'),10),d=1200,t0=null;function s(ts){if(!t0)t0=ts;var p=Math.min((ts-t0)/d,1);el.textContent=Math.floor((1-Math.pow(1-p,3))*t).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.');if(p<1)requestAnimationFrame(s);else el.textContent=t.toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.');}requestAnimationFrame(s);}
var cio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){cu(e.target);cio.unobserve(e.target);}});},{threshold:.6});
R.querySelectorAll('[data-count]').forEach(function(e){cio.observe(e);});
}

var sk=R.querySelector('[data-sticky]');
if(sk){var mainF=null;document.querySelectorAll('form[action*="/cart/add"]').forEach(function(f){if(!mainF&&!f.classList.contains('wp-atc'))mainF=f;});
 var past=false,ft=false;function skU(){var on;if(mainF){var r=mainF.getBoundingClientRect();on=r.bottom<0;}else{on=scrollY>700;}
 var fin=R.querySelector('.wp-final');if(fin){var fr=fin.getBoundingClientRect();if(fr.top<innerHeight*.6&&fr.bottom>0)on=false;}
 sk.classList.toggle('is-on',on);}
 addEventListener('scroll',function(){if(!ft){ft=true;requestAnimationFrame(function(){ft=false;skU();});}},{passive:true});skU();
 document.body.appendChild(sk);}

var GAP=12,EDGE=20;
R.querySelectorAll('.wa-top').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();window.scrollTo({top:0,behavior:'smooth'});});});
function size(){var N=matchMedia('(max-width:768px)').matches?3:5;R.querySelectorAll('.wa-ugc-track').forEach(function(t){var w=t.getBoundingClientRect().width,sw=(w-EDGE*2-GAP*(N-1))/N;if(sw<=0)return;t.querySelectorAll('.wa-ugc-item').forEach(function(s){s.style.flex='0 0 '+sw+'px';s.style.width=s.style.minWidth=s.style.maxWidth=sw+'px';});});}
function auto(){R.querySelectorAll('.wa-ugc-track').forEach(function(t){if(t.__x)return;var d=parseInt(t.getAttribute('data-autoscroll')||'4000',10);t.__x=setInterval(function(){var m=t.scrollWidth-t.clientWidth;if(m<=2)return;if(t.scrollLeft>=m-2)t.scrollTo({left:0,behavior:'smooth'});else{var n=t.scrollLeft+t.clientWidth;if(n>m)n=m;t.scrollTo({left:n,behavior:'smooth'});}},d);});}
size();if(!reduce)auto();addEventListener('load',size);addEventListener('resize',size);
})();
