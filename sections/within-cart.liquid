    { "type": "text", "id": "step_2", "label": "Passaggio 2", "default": "Spedizione" },
    { "type": "text", "id": "step_3", "label": "Passaggio 3", "default": "Pagamento" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Il tuo carrello" },
    { "type": "textarea", "id": "sub", "label": "Sottotitolo", "default": "Ancora un passo. E da qui in poi il rischio è nostro: hai 90 giorni per decidere se Within fa per te." },

    { "type": "header", "content": "Spedizione gratuita" },
    { "type": "number", "id": "free_ship_threshold", "label": "Soglia spedizione gratuita (€, 0 = nascondi la barra)", "default": 0 },
    { "type": "text", "id": "free_ship_text", "label": "Testo sotto soglia ([importo] = quanto manca)", "default": "Ti mancano [importo] per la spedizione gratuita." },
    { "type": "text", "id": "free_ship_done", "label": "Testo soglia raggiunta", "default": "La spedizione è gratuita. Te la offriamo noi." },

    { "type": "header", "content": "Il tuo percorso (giorni coperti)" },
    { "type": "paragraph", "content": "Conta quante confezioni del prodotto scelto ci sono nel carrello e mostra quanti giorni copre, con i traguardi del percorso e un pulsante per raggiungere il prossimo." },
    { "type": "checkbox", "id": "path_enabled", "label": "Mostra il percorso", "default": true },
    { "type": "product", "id": "path_product", "label": "Prodotto" },
    { "type": "number", "id": "sachets_per_box", "label": "Sachet (giorni) per confezione", "default": 10 },
    { "type": "text", "id": "days_label", "label": "Etichetta sul prodotto ([giorni])", "default": "[giorni] sachet · [giorni] giorni" },
