    { "type": "color", "id": "muted_color", "label": "Testo secondario", "default": "#6B6358" },
    { "type": "color", "id": "line_color", "label": "Linee e bordi", "default": "#E0D8CA" },
    { "type": "color", "id": "dark_color", "label": "Scuro (box percorso)", "default": "#1C2B28" },
    { "type": "color", "id": "on_dark_color", "label": "Testo su scuro", "default": "#F7F3EC" },
    { "type": "color", "id": "accent_color", "label": "Accento", "default": "#A8432E" },
    { "type": "color", "id": "mango_color", "label": "Mango", "default": "#E07D3A" },
    { "type": "color", "id": "gold_color", "label": "Passion fruit", "default": "#F2C05C" },
    { "type": "color", "id": "btn_color", "label": "Pulsante", "default": "#CC5B3E" },
    { "type": "color", "id": "btn_hover_color", "label": "Pulsante hover", "default": "#A8432E" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Domanda",
      "settings": [
        { "type": "text", "id": "q", "label": "Domanda", "default": "Domanda" },
        { "type": "richtext", "id": "a", "label": "Risposta", "default": "<p>Risposta</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Within · Carrello", "blocks": [{ "type": "faq" }] }
  ]
}
{% endschema %}
