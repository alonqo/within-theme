    { "type": "text", "id": "code_note", "label": "Nota codice sconto", "default": "Hai un codice sconto? Lo inserisci al passo successivo." },
    { "type": "checkbox", "id": "show_note", "label": "Mostra note per l'ordine", "default": false },
    { "type": "text", "id": "note_label", "label": "Note · titolo", "default": "Aggiungi una nota all'ordine" },
    { "type": "text", "id": "remove_label", "label": "Testo rimuovi", "default": "Rimuovi" },
    { "type": "text", "id": "sticky_label", "label": "Barra mobile · pulsante", "default": "Vai al pagamento" },

    { "type": "header", "content": "Garanzia" },
    { "type": "text", "id": "g_days", "label": "Giorni (sigillo)", "default": "90" },
    { "type": "text", "id": "g_title", "label": "Nome garanzia (vuoto = nascondi)", "default": "Garanzia Specchio · 90 giorni" },
