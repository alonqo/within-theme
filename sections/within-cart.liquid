    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "color", "id": "bg_color", "label": "Sfondo", "default": "#FAF7F2" },
