    { "type": "text", "id": "next_1_text", "label": "Passo 1 · testo", "default": "Un'email con il riepilogo dell'ordine, subito." },
    { "type": "text", "id": "next_2_title", "label": "Passo 2 · titolo", "default": "Prepariamo il pacco" },
    { "type": "text", "id": "next_2_text", "label": "Passo 2 · testo", "default": "Parte con corriere tracciato. Il codice arriva per email." },
    { "type": "text", "id": "next_3_title", "label": "Passo 3 · titolo", "default": "Un sachet al giorno" },
    { "type": "text", "id": "next_3_text", "label": "Passo 3 · testo", "default": "Già liquido, sa di mango. Lo bevi in 25 secondi, dove vuoi." },
    { "type": "text", "id": "next_4_title", "label": "Passo 4 · titolo", "default": "Hai 90 giorni per decidere" },
    { "type": "text", "id": "next_4_text", "label": "Passo 4 · testo", "default": "Se non ti convince, una email e ti rimborsiamo." },
    { "type": "text", "id": "faq_title", "label": "Titolo domande", "default": "Prima di pagare" },

    { "type": "header", "content": "Carrello vuoto" },
    { "type": "text", "id": "empty_title", "label": "Titolo", "default": "Il tuo carrello è vuoto." },
    { "type": "textarea", "id": "empty_text", "label": "Testo", "default": "Dopo i 25 anni il corpo perde ogni anno l'1-1,5% del suo collagene. Ogni mese che aspetti è un mese in meno nel tuo percorso." },
    { "type": "text", "id": "empty_cta", "label": "Pulsante", "default": "Scopri Within" },
    { "type": "url", "id": "empty_url", "label": "Link pulsante (vuoto = prodotto del percorso)" },
    { "type": "text", "id": "empty_note", "label": "Sotto il pulsante", "default": "Garanzia 90 giorni · Non è un abbonamento" },

    { "type": "header", "content": "Layout e colori" },
